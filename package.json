{
  "name": "keypillar-audit-task-tracking-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "BACKEND_HOST=0.0.0.0 BACKEND_PORT=4000 ts-node -r tsconfig-paths/register --project backend/tsconfig.json backend/src/main.ts",
    "build": "tsc -p backend/tsconfig.build.json",
    "start": "BACKEND_HOST=0.0.0.0 BACKEND_PORT=4000 node backend/dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
